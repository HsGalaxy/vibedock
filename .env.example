# The control plane is local-only by default. Keep this value when an HTTPS
# reverse proxy runs on the same host. Change it only after the first admin
# account has been created and access is protected by HTTPS and a firewall.
VIBEDOCK_BIND_ADDRESS=127.0.0.1
VIBEDOCK_PORT=8787
# Arbitrary Workspace previews use a separate browser origin.
VIBEDOCK_PREVIEW_PORT=8788
# Set an explicit public origin only when an HTTPS proxy exposes previews on
# the same hostname at another port, for example https://vibedock.example.com:8443.
VIBEDOCK_PREVIEW_ORIGIN=
VIBEDOCK_DOCKER_NETWORK=vibedock

# Browser sessions expire after this idle-independent lifetime. Proxy headers
# must be trusted only when 8787 and 8788 are reachable exclusively through
# your HTTPS proxy; direct clients could otherwise spoof their source and scheme.
VIBEDOCK_SESSION_TTL=12h
VIBEDOCK_TRUST_PROXY_HEADERS=false

# Optional: provide a stable 32-byte key as base64url/base64/hex.
# When empty, VibeDock generates data/credential.key with mode 0600.
VIBEDOCK_CREDENTIAL_KEY=

# Fixed official CLI login-helper image and bounded helper lifecycle.
VIBEDOCK_AUTH_HELPER_IMAGE=vibedock/workspace:local
VIBEDOCK_LOGIN_TTL=15m
# The server enforces an upper bound of 3 even if a larger value is supplied.
VIBEDOCK_MAX_LOGIN_HELPERS=3
