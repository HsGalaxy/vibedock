VIBEDOCK_PORT=8787
VIBEDOCK_DOCKER_NETWORK=vibedock
VIBEDOCK_ADMIN_USER=vibe
# Strongly recommended for any remote deployment. Leave empty only on a trusted local network.
VIBEDOCK_ADMIN_PASSWORD=

# Optional: provide a stable 32-byte key as base64url/base64/hex.
# When empty, VibeDock generates data/credential.key with mode 0600.
VIBEDOCK_CREDENTIAL_KEY=

# Fixed official CLI login-helper image and bounded helper lifecycle.
VIBEDOCK_AUTH_HELPER_IMAGE=vibedock/workspace:local
VIBEDOCK_LOGIN_TTL=15m
# The server enforces an upper bound of 3 even if a larger value is supplied.
VIBEDOCK_MAX_LOGIN_HELPERS=3
